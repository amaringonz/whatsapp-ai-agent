{
  "name": "whatsapp-ai-agent",
  "version": "0.1.0",
  "description": "A business-specific AI agent for WhatsApp that answers customers, qualifies leads, books appointments and hands the conversation to a human only when it is done or urgent.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "chat": "tsx scripts/chat.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm test"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.13.0",
    "@hono/node-server": "^2.1.11",
    "@upstash/redis": "^1.41.0",
    "@vercel/functions": "^3.11.3",
    "hono": "^4.13.21",
    "resend": "^6.39.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.1.1"
  },
  "keywords": [
    "whatsapp",
    "whatsapp-cloud-api",
    "ai-agent",
    "claude",
    "anthropic",
    "chatbot",
    "lead-qualification",
    "hono",
    "vercel"
  ]
}
